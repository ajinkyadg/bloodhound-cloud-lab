# NOTE: verify this against the current upstream compose file before your first deploy:
# https://github.com/SpecterOps/BloodHound/blob/main/examples/docker-compose/docker-compose.yml
# Image tags and env var names have moved before; this was correct as of early 2026.
services:
  app-db:
    image: docker.io/library/postgres:16
    environment:
      - POSTGRES_USER=bloodhound
      - POSTGRES_PASSWORD=__BLOODHOUND_POSTGRES_PASSWORD__
      - POSTGRES_DB=bloodhound
    volumes:
      - /data/postgres:/var/lib/postgresql/data
    restart: unless-stopped

  graph-db:
    image: docker.io/library/neo4j:4.4
    environment:
      - NEO4J_AUTH=neo4j/__BLOODHOUND_NEO4J_PASSWORD__
      - NEO4J_dbms_allow__upgrade=true
    volumes:
      - /data/neo4j:/data
    restart: unless-stopped

  bloodhound:
    image: docker.io/specterops/bloodhound:latest
    environment:
      - bhe_database_connection=user=bloodhound password=__BLOODHOUND_POSTGRES_PASSWORD__ dbname=bloodhound host=app-db
      - bhe_neo4j_connection=neo4j://neo4j:__BLOODHOUND_NEO4J_PASSWORD__@graph-db:7687/
      - bhe_disable_cypher_complexity_limit=false
      - bhe_enable_start_tls=false
    ports:
      - "127.0.0.1:8080:8080"
    depends_on:
      - app-db
      - graph-db
    restart: unless-stopped

  caddy:
    image: docker.io/library/caddy:2
    ports:
      - "${bloodhound_port}:${bloodhound_port}"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile
      - ./tls:/tls
    depends_on:
      - bloodhound
    restart: unless-stopped
